APP_ENV=development
SECRET_KEY=
DATABASE_URL=postgresql+psycopg://enfermeria_app:CAMBIAR@localhost:5432/enfermeria
# Solo se utiliza si victor todavía no existe. Retirar después de inicializar.
INITIAL_ADMIN_PASSWORD=
TRUSTED_HOSTS=localhost,127.0.0.1
SESSION_COOKIE_SECURE=false
# Activar solo detrás de un proxy confiable que sobrescriba X-Forwarded-*.
TRUST_PROXY=false

# Adjuntos: local privado y persistente para este equipo.
# En Railway usar s3 o un volumen montado expresamente; nunca el disco efímero.
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_LOCAL_ROOT=
DOCUMENT_LOCAL_PERSISTENT=false
DOCUMENT_MAX_BYTES=8388608
DOCUMENT_MAX_FILES=5
DOCUMENT_MAX_PIXELS=40000000
DOCUMENT_PREVIEW_EDGE=2400
# Credenciales únicamente en .env privado o secretos del proveedor, nunca en Git.
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_ENDPOINT=
DOCUMENT_S3_REGION=us-east-1
DOCUMENT_S3_ACCESS_KEY=
DOCUMENT_S3_SECRET_KEY=
# AES256 para AWS. En proveedores que no acepten esta opción, dejar vacío
# y habilitar cifrado en reposo desde la configuración del proveedor.
DOCUMENT_S3_SSE=AES256
